# ---------- Google Cloud (Vertex AI) ----------
# Local: uses your gcloud Application Default Credentials (gcloud auth application-default login).
# Cloud Run: uses the service account attached to the service. No API key is needed either way.
GOOGLE_CLOUD_PROJECT=team-bubu
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
LYRIA_LOCATION=us-central1
LYRIA_MODEL=lyria-002
# Google Cloud Text-to-Speech voice for the blackboard speaker buttons (a female Chirp 3 HD voice).
TTS_VOICE=en-US-Chirp3-HD-Aoede
TTS_SPEAKING_RATE=1.15
# Synthesize all sections right after the analysis, so the speaker buttons play at once (~US$0.09 per record).
TTS_PREFETCH=true

# ---------- MusicGen on Colab (colab CLI) ----------
MUSICGEN_ENABLED=true
MUSICGEN_MODEL=facebook/musicgen-medium
MUSICGEN_SECONDS=30
# Give up on one generation after this long (a normal 30 s clip takes ~80 s on a T4).
MUSICGEN_TIMEOUT_SECONDS=300
COLAB_AUTH=oauth2
COLAB_GPU=T4
COLAB_SESSION=jukebox-musicgen
# Stop the Colab VM after this many idle minutes so it stops burning compute units.
COLAB_IDLE_STOP_MINUTES=15

# ---------- App ----------
# Base for share links: http://localhost:8000 locally, https://nasa2026.scsonic.com in production.
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
# Per client IP: at most RATE_LIMIT_COUNT generations in RATE_LIMIT_WINDOW_MINUTES
RATE_LIMIT_COUNT=30
RATE_LIMIT_WINDOW_MINUTES=30
# Convert WAV to MP3 with ffmpeg when available (smaller files for sharing).
TRANSCODE_MP3=true
